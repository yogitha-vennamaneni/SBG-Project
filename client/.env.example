# Vite environment variables (prefix with VITE_ to expose to browser)

# API base URL — leave empty to use the Vite proxy (development)
VITE_API_URL=

# App
VITE_APP_NAME=SBG Scheduler
VITE_APP_VERSION=1.0.0

# ─── Auth0 ─────────────────────────────────────────────────────────────────────
# From an Auth0 Application registered as "Single Page Application" (must be a
# different Application than the API/M2M ones the server uses).
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
# Must match the server's AUTH0_AUDIENCE so the SPA requests a token this API accepts.
VITE_AUTH0_AUDIENCE=https://api.sbg-scheduler.com.au
# Only needed if your tenant's role-claim Action uses a non-default namespace —
# see server/.env.example's AUTH0_ROLES_CLAIM.
VITE_AUTH0_ROLES_CLAIM=https://sbg-scheduler.com/roles
# Master switch — leave "false" until VITE_AUTH0_DOMAIN/CLIENT_ID are real and
# the server's AUTH_ENABLED is also "true". Login is unreachable while off.
VITE_AUTH_ENABLED=true

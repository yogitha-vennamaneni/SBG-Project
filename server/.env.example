# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Neon (serverless PostgreSQL 16) ─────────────────────────────────────────
# From your Neon project dashboard → Connection Details
# (use the pooled connection string for the app; the direct one for migrations)
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/sbg_scheduler?sslmode=require
# Neon always requires SSL — leave true; set to "false" only against local Postgres
PGSSL=true

# ─── Google Cloud Storage ─────────────────────────────────────────────────────
# Bucket for job photos and generated PDFs; objects are served via short-lived
# signed URLs rather than public ACLs.
GCS_BUCKET_NAME=sbg-scheduler-uploads
GCS_PROJECT_ID=your-gcp-project-id
# Path to a service-account key JSON file (omit if running on GCP with
# Application Default Credentials / Workload Identity)
GOOGLE_APPLICATION_CREDENTIALS=./gcs-service-account.json
# How long generated read URLs stay valid
GCS_SIGNED_URL_EXPIRY_MINUTES=15

# ─── Auth0 ─────────────────────────────────────────────────────────────────────
# API is validated as a resource server: incoming access tokens are RS256-signed
# JWTs, verified against Auth0's JWKS endpoint (no shared secret on this side).
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.sbg-scheduler.com.au
# Namespaced custom claim an Auth0 Action adds to the access token, e.g. ["admin"]
# or ["technician"] — see server/src/middleware/auth.ts. Only needs changing if
# your tenant's Login-flow Action uses a different namespace.
AUTH0_ROLES_CLAIM=https://sbg-scheduler.com/roles
# Master switch for enforcing auth on the API. Leave "false" until the tenant,
# SPA client, and role-claim Action are all confirmed working end to end —
# every /api/* data route rejects all requests once this flips to "true".
AUTH_ENABLED=false

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Payment Link template IDs (optional — use payment links for invoices)
STRIPE_DEPOSIT_PRICE_ID=price_...
STRIPE_BALANCE_PRICE_ID=price_...

# ─── DocuSeal (e-signature) ────────────────────────────────────────────────────
# Open-source (MIT), self-hosted — free, unlimited use, full API + webhooks.
# Run it yourself: `docker run -p 3000:3000 -v docuseal_data:/data docuseal/docuseal`
# then point this at that instance. Use https://api.docuseal.com instead if you
# switch to their hosted plan.
DOCUSEAL_API_URL=http://localhost:3000
DOCUSEAL_API_KEY=your-docuseal-api-key
# From the webhook's Security → HMAC tab in the DocuSeal dashboard
DOCUSEAL_WEBHOOK_SECRET=whsec_...
# Template IDs created in the DocuSeal dashboard (Templates → Create Template)
DOCUSEAL_SOLAR_TEMPLATE_ID=template_...
DOCUSEAL_BATTERY_TEMPLATE_ID=template_...
DOCUSEAL_EV_TEMPLATE_ID=template_...
DOCUSEAL_ROOF_TEMPLATE_ID=template_...
DOCUSEAL_ADJUSTMENT_TEMPLATE_ID=template_...

# ─── Resend (email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=quotes@solarbatterygroup.com.au
RESEND_FROM_NAME=Solar Battery Group

# ─── OpenWeatherMap ───────────────────────────────────────────────────────────
# Leave empty to use built-in mock data (5-day forecast simulation).
# Requires a key subscribed to One Call API 3.0 (has its own free tier of
# 1,000 calls/day — subscribe separately even on an existing free-plan key).
# The Geocoding API used to resolve postcodes to lat/lon works with any key.
OPENWEATHER_API_KEY=

# ─── App ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
STC_UNIT_PRICE_AUD=38
